@NeAvito_HostAddress = https://localhost:7153

### Замените порт на HTTPS-порт из окна запуска
POST {{NeAvito_HostAddress}}/api/auth/register
X-NeAvito-Request: 1
Content-Type: application/json

{
  "email": "buyer@example.com",
  "password": "TestPassword123!",
  "displayName": "Покупатель"
}

### Повторная отправка письма подтверждения
POST {{NeAvito_HostAddress}}/api/auth/resend-confirmation
X-NeAvito-Request: 1
Content-Type: application/json

{
  "email": "buyer@example.com"
}

### Подтвердите почту, открыв ссылку из письма и нажав «Подтвердить почту»

### Вход после подтверждения (клиент должен сохранять cookie)
POST {{NeAvito_HostAddress}}/api/auth/login
X-NeAvito-Request: 1
Content-Type: application/json

{
  "email": "buyer@example.com",
  "password": "TestPassword123!"
}

### Текущий пользователь
GET {{NeAvito_HostAddress}}/api/auth/me

### Выход
POST {{NeAvito_HostAddress}}/api/auth/logout
X-NeAvito-Request: 1

### Смена пароля из профиля (после входа; завершает все прежние сеансы)
POST {{NeAvito_HostAddress}}/api/auth/change-password
X-NeAvito-Request: 1
Content-Type: application/json

{
  "currentPassword": "TestPassword123!",
  "newPassword": "UpdatedPassword456!"
}

### Выйти на всех устройствах, включая текущее (после входа)
POST {{NeAvito_HostAddress}}/api/auth/logout-all
X-NeAvito-Request: 1

### Запросить восстановление, затем открыть ссылку из письма и указать новый пароль
POST {{NeAvito_HostAddress}}/api/auth/forgot-password
X-NeAvito-Request: 1
Content-Type: application/json

{
  "email": "buyer@example.com"
}


### Категории
GET {{NeAvito_HostAddress}}/api/catalog/categories

### Каталог: поиск, фильтр категории, диапазон цен и сортировка
GET {{NeAvito_HostAddress}}/api/catalog/products?search=телефон&categoryId=3&minPrice=100&maxPrice=100000&sort=price_asc&page=1&pageSize=20

### Каталог: новые товары
GET {{NeAvito_HostAddress}}/api/catalog/products?sort=newest&page=1&pageSize=20

### Карточка: замените GUID на идентификатор опубликованного товара
GET {{NeAvito_HostAddress}}/api/catalog/products/00000000-0000-0000-0000-000000000000

### Создать черновик (после входа)
POST {{NeAvito_HostAddress}}/api/seller/products
X-NeAvito-Request: 1
Content-Type: application/json

{
  "name": "Телефон",
  "description": "Телефон в хорошем состоянии",
  "price": 12500.50,
  "stock": 1,
  "categoryId": 3
}

### Замените идентификатор и версию значениями ответа
@ProductId = 00000000-0000-0000-0000-000000000000
@ProductVersion = 00000000-0000-0000-0000-000000000000

### Мои товары
GET {{NeAvito_HostAddress}}/api/seller/products?page=1&pageSize=20

### Получить свою карточку и актуальную version
GET {{NeAvito_HostAddress}}/api/seller/products/{{ProductId}}

### Редактировать товар
PUT {{NeAvito_HostAddress}}/api/seller/products/{{ProductId}}
X-NeAvito-Request: 1
Content-Type: application/json

{
  "name": "Телефон",
  "description": "Обновленное описание",
  "price": 12000,
  "stock": 1,
  "categoryId": 3,
  "version": "{{ProductVersion}}"
}

### Опубликовать
POST {{NeAvito_HostAddress}}/api/seller/products/{{ProductId}}/publish
X-NeAvito-Request: 1

### Снять с публикации
POST {{NeAvito_HostAddress}}/api/seller/products/{{ProductId}}/unpublish
X-NeAvito-Request: 1

### Моя корзина
GET {{NeAvito_HostAddress}}/api/cart

### Добавить товар или установить количество (после входа)
PUT {{NeAvito_HostAddress}}/api/cart/items/{{ProductId}}
X-NeAvito-Request: 1
Content-Type: application/json

{
  "quantity": 2
}

### Удалить позицию
DELETE {{NeAvito_HostAddress}}/api/cart/items/{{ProductId}}
X-NeAvito-Request: 1

### Очистить корзину
DELETE {{NeAvito_HostAddress}}/api/cart
X-NeAvito-Request: 1

### История моих заказов
GET {{NeAvito_HostAddress}}/api/orders?page=1&pageSize=20

### Оформление: замените requestId новым GUID, productId, version, quantity и unitPrice данными GET /api/cart
POST {{NeAvito_HostAddress}}/api/orders/checkout
X-NeAvito-Request: 1
Content-Type: application/json

{
  "requestId": "11111111-1111-4111-8111-111111111111",
  "recipientName": "Иван",
  "phone": "+79991234567",
  "deliveryAddress": "Согласованное место получения",
  "items": [
    {
      "productId": "{{ProductId}}",
      "version": "00000000-0000-0000-0000-000000000000",
      "quantity": 1,
      "unitPrice": 12000
    }
  ]
}

@OrderId = 00000000-0000-0000-0000-000000000000

### Карточка моего заказа (покупатель)
GET {{NeAvito_HostAddress}}/api/orders/{{OrderId}}

### Отмена покупателем
POST {{NeAvito_HostAddress}}/api/orders/{{OrderId}}/cancel
X-NeAvito-Request: 1

### Полученные заказы (продавец)
GET {{NeAvito_HostAddress}}/api/seller/orders?page=1&pageSize=20

### Подтвердить заказ (продавец)
POST {{NeAvito_HostAddress}}/api/seller/orders/{{OrderId}}/status
X-NeAvito-Request: 1
Content-Type: application/json

{
  "status": "Confirmed"
}

### Завершить заказ (продавец)
POST {{NeAvito_HostAddress}}/api/seller/orders/{{OrderId}}/status
X-NeAvito-Request: 1
Content-Type: application/json

{
  "status": "Completed"
}


### Мой профиль
GET {{NeAvito_HostAddress}}/api/profile

### Изменить профиль (version берется из GET /api/profile)
PUT {{NeAvito_HostAddress}}/api/profile
X-NeAvito-Request: 1
Content-Type: application/json

{
  "displayName": "Иван",
  "phone": "+79991234567",
  "deliveryAddress": "Удобное место получения",
  "version": "ЗАМЕНИТЕ_ВЕРСИЕЙ_ПРОФИЛЯ"
}
